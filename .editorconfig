# EditorConfig — harmonise la mise en forme entre tous les éditeurs.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_size = 100

[*.md]
# En Markdown, deux espaces en fin de ligne signifient "retour à la ligne".
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
