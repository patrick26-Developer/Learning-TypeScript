# -----------------------------------------------------------------------------
# Modèle de variables d'environnement.
#
# RÈGLE ABSOLUE (module 11) : ce fichier .env.example est le SEUL fichier
# d'environnement suivi par Git. Copiez-le en .env et remplissez vos propres
# valeurs — .env est ignoré par .gitignore et ne doit JAMAIS être committé.
#
#   cp .env.example .env
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Base de données (docker compose -f infra/docker/compose.dev.yaml up -d) -
DATABASE_URL="postgresql://atlas:atlas_dev_only@localhost:5432/atlas_dev"

# --- Cache --------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Authentification ---------------------------------------------------
# Générez une vraie valeur avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne réutilisez JAMAIS la valeur d'exemple ci-dessous, même en développement.
JWT_SECRET="remplacez-moi-par-une-valeur-generee-aleatoirement"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="7d"
