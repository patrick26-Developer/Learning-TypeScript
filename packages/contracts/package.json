{
  "name": "@atlas/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contrat d'API partagé entre le backend et les trois projets finaux (NEXUS, PULSE, TRAIL). Un schéma, deux usages : type statique + validation runtime.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@atlas/eslint-config": "workspace:*",
    "@atlas/tsconfig": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
