# ---------------------------------------------------------------------------
# Configuration pnpm du monorepo.
# ---------------------------------------------------------------------------

# Les dépendances ne sont PAS remontées à plat dans un node_modules global.
# Conséquence pédagogique majeure : si un paquet n'est pas déclaré dans le
# package.json qui l'importe, l'import échoue. On élimine ainsi les
# "dépendances fantômes" (phantom dependencies), source classique de bugs
# qui n'apparaissent qu'en production.
hoist=false

# Refuse d'installer si le lockfile devrait être modifié en CI.
# (Actif uniquement quand la variable CI=true est présente.)
strict-peer-dependencies=false

# Affiche les avertissements de peer dependencies non satisfaites :
# on veut les VOIR, pas les masquer.
auto-install-peers=true

# Active les scripts `pre*` / `post*` de nos PROPRES package.json
# (ex. : `prebuild` s'exécute avant `build`). Rien à voir avec la sécurité :
# le blocage des scripts d'installation des DÉPENDANCES est natif à pnpm 10
# et se pilote via `onlyBuiltDependencies` dans pnpm-workspace.yaml.
enable-pre-post-scripts=true

# Version de Node.js exigée : échoue tôt et clairement plutôt que
# de produire une erreur incompréhensible au runtime.
engine-strict=true
